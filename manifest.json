{
  "manifest_version": 3,
  "name": "ScrollSentinel",
  "version": "2.8.0",
  "description": "YouTube schedules and focus limits, plus a 2-minute wellness break after 60 minutes of video across YouTube, Facebook, Instagram and TikTok.",
  "icons": {
    "16": "icons/scrollsentinel-16.png",
    "32": "icons/scrollsentinel-32.png",
    "48": "icons/scrollsentinel-48.png",
    "64": "icons/scrollsentinel-64.png",
    "96": "icons/scrollsentinel-96.png",
    "128": "icons/scrollsentinel-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://fb.watch/*",
    "*://*.fb.watch/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*"
  ],
  "background": {
    "scripts": [
      "schedule.js",
      "break-core.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scrollsentinel-16.png",
      "32": "icons/scrollsentinel-32.png",
      "48": "icons/scrollsentinel-48.png",
      "64": "icons/scrollsentinel-64.png",
      "128": "icons/scrollsentinel-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "schedule.js",
        "quest-stories.js",
        "guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*",
        "*://*.fb.watch/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "break-core.js",
        "break-visual.js",
        "break.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-focus-hours@example.org",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
