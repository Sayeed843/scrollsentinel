{
  "manifest_version": 3,
  "name": "ScrollSentinel",
  "version": "2.5.1",
  "description": "Focus on YouTube today: scheduled access, daily limits, Strict Mode and cybersecurity learning quests. More platforms planned.",
  "icons": {
    "16": "icons/scrollsentinel.svg",
    "32": "icons/scrollsentinel.svg",
    "48": "icons/scrollsentinel.svg",
    "96": "icons/scrollsentinel.svg",
    "128": "icons/scrollsentinel.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scrollsentinel.svg",
      "32": "icons/scrollsentinel.svg",
      "48": "icons/scrollsentinel.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "quest-stories.js",
        "guard.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-focus-hours@example.org"
    }
  }
}
